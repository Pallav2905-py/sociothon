# EduBridge AI — Environment Configuration
# Copy this file to .env and fill in your values

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./edubridge.db

# ─── IBM Granite LLM ──────────────────────────────────────────────────────────
# Obtain from IBM watsonx.ai or IBM Cloud
GRANITE_API_URL=
GRANITE_API_KEY=
GRANITE_MODEL_ID=ibm/granite-3-8b-instruct
GRANITE_PROJECT_ID=

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Options: granite | development
LLM_PROVIDER=granite
# Set to true ONLY during development when Granite credentials are unavailable
ALLOW_DEVELOPMENT_FALLBACK=true

# ─── Embedding Model ──────────────────────────────────────────────────────────
# Multilingual model supporting Marathi, Hindi, English
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ─── Vector Storage ───────────────────────────────────────────────────────────
VECTOR_STORE_PATH=./storage/vector_store
VECTOR_STORE_TYPE=faiss

# ─── File Storage ─────────────────────────────────────────────────────────────
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=20

# ─── Retrieval ────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.3

# ─── Authentication ───────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-secret-key-change-in-production-12345
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
